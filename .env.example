# Copy to .env and fill in your own values. Never commit .env.
OPENAI_API_KEY=
SUPABASE_URL=
# Backend secret/service-role key; never put this key in Flutter.
SUPABASE_KEY=
# Optional publishable/anon key for the separate Auth-only client. Never the backend secret in Flutter.
SUPABASE_PUBLISHABLE_KEY=
OPENAI_MODEL=gpt-4o-mini
STT_MODEL=whisper-1
TTS_MODEL=tts-1
TTS_VOICE=nova
API_HOST=127.0.0.1
API_PORT=8000
APP_ENV=development
CORS_ORIGINS=*
# Keep true for real users. Set false ONLY for local development with PROFILE_ID.
AUTH_REQUIRED=true
